@import 'tailwindcss';
@import '@fontsource-variable/space-grotesk';
@import '@fontsource-variable/inter';
@import './utilities/typography.css';
@import './utilities/glass.css';

@custom-variant dark (&:is(.dark *));

/* 
  =========================================
  1. BASE COLOR PALETTES
  =========================================
*/
@theme {
  --font-sans: 'Inter Variable', 'Inter', ui-sans-serif, system-ui, sans-serif;
  --font-heading:
    'Space Grotesk Variable', 'Space Grotesk', ui-sans-serif, system-ui,
    sans-serif;

  /* LAYER 0: TOKYO CORE PALETTE (Theme Independent) */
  --color-tokyo-linen: #f2f0eb;
  --color-tokyo-stone: #cfc9c2;
  --color-tokyo-red: #f7768e;
  --color-tokyo-orange: #ff9e64;
  --color-tokyo-yellow: #e0af68;
  --color-tokyo-green: #9ece6a;
  --color-tokyo-teal: #73daca;
  --color-tokyo-cyan: #b4f9f8;
  --color-tokyo-blue: #7aa2f7;
  --color-tokyo-light-blue: #7dcfff;
  --color-tokyo-sky: #2ac3de;
  --color-tokyo-purple: #bb9af7;
  --color-tokyo-lavender: #c0caf5;
  --color-tokyo-white: #ffffff;

  /* LAYER 0: TOKYO LINEN SCALE (Light Mode Monochromes) */
  --color-tokyo-linen-100: #e5ecf9;
  --color-tokyo-linen-200: #e0e5f0;
  --color-tokyo-linen-300: #c7d2e8;
  --color-tokyo-linen-600: #697da4;
  --color-tokyo-linen-900: #375493;

  /* LAYER 0: TOKYO STORM SCALE (Dark Mode Monochromes) */
  --color-tokyo-storm-100: oklch(0.7882 0.0434 264.46);
  --color-tokyo-storm-400: oklch(0.52 0.04 264.46);
  --color-tokyo-storm-600: oklch(0.3 0.035 264.05);
  --color-tokyo-storm-700: oklch(0.28 0.032 264.05);
  --color-tokyo-storm-800: oklch(0.24 0.032 264.05);
  --color-tokyo-storm-850: oklch(0.195 0.028 264.05);
  --color-tokyo-storm-900: oklch(0.17 0.025 264.05);
  --color-tokyo-storm-950: oklch(0.145 0.022 264.05);

  /* LAYER 1: TOKYO LINEN (LIGHT) PRIMITIVES */
  --color-tl-canvas: var(--color-tokyo-linen);
  --color-tl-white: var(--color-tokyo-white);
  --color-tl-text: var(--color-tokyo-linen-900);
  --color-tl-primary: var(--color-tokyo-blue);
  --color-tl-surface-low: var(--color-tokyo-linen-200);
  --color-tl-surface-high: var(--color-tokyo-linen-100);
  --color-tl-muted-text: var(--color-tokyo-linen-600);
  --color-tl-border: var(--color-tokyo-linen-300);

  --color-tl-destructive: var(--color-tokyo-red);
  --color-tl-success: var(--color-tokyo-green);
  --color-tl-warning: var(--color-tokyo-yellow);
  --color-tl-info: var(--color-tokyo-blue);

  /* LAYER 2: TOKYO NIGHT (DARK) PRIMITIVES */
  --color-tn-canvas: var(--color-tokyo-storm-950);
  --color-tn-text: var(--color-tokyo-lavender);
  --color-tn-surface: var(--color-tokyo-storm-850);
  --color-tn-primary: var(--color-tokyo-blue);
  --color-tn-surface-low: var(--color-tokyo-storm-900);
  --color-tn-surface-high: var(--color-tokyo-storm-800);
  --color-tn-surface-muted: var(--color-tokyo-storm-700);
  --color-tn-muted-text: var(--color-tokyo-storm-400);
  --color-tn-border: var(--color-tokyo-storm-600);

  --color-tn-destructive: var(--color-tokyo-red);
  --color-tn-success: var(--color-tokyo-green);
  --color-tn-warning: var(--color-tokyo-yellow);
  --color-tn-info: var(--color-tokyo-blue);

  /* LAYER 3: COMPONENT TOKENS TO THEME AUTO-MAPPING */
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-success: var(--success);
  --color-success-foreground: var(--success-foreground);
  --color-warning: var(--warning);
  --color-warning-foreground: var(--warning-foreground);
  --color-info: var(--info);
  --color-info-foreground: var(--info-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);

  --color-surface-low: var(--surface-low);
  --color-surface-high: var(--surface-high);

  --color-coral: var(--coral);
  --color-coral-foreground: var(--coral-foreground);
  --color-purple: var(--purple);
  --color-purple-foreground: var(--purple-foreground);

  --color-chart-1: var(--primary);
  --color-chart-2: var(--info);
  --color-chart-3: var(--success);
  --color-chart-4: var(--warning);
  --color-chart-5: var(--destructive);

  --color-sidebar: var(--sidebar);
  --color-sidebar-foreground: var(--foreground);
  --color-sidebar-primary: var(--primary);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-accent: var(--accent);
  --color-sidebar-accent-foreground: var(--foreground);
  --color-sidebar-border: var(--border);
  --color-sidebar-ring: var(--ring);

  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

/* 
  =========================================
  2. THEME IMPLEMENTATION
  =========================================
*/
@layer base {
  :root {
    /* UNIVERSAL COMMON ALIASES */
    --card-foreground: var(--foreground);
    --popover-foreground: var(--foreground);
    --secondary-foreground: var(--foreground);
    --accent-foreground: var(--foreground);
    --input: var(--border);
    --ring: var(--primary);

    /* TOKYO LINEN (LIGHT) MAPPINGS */
    --background: var(--color-tl-canvas);
    --foreground: var(--color-tl-text);
    --card: var(--color-tl-white);
    --popover: var(--color-tl-white);

    --primary: var(--color-tl-primary);
    --primary-foreground: var(--color-tl-white);

    --secondary: var(--color-tl-surface-low);
    --muted: var(--color-tl-surface-low);
    --muted-foreground: var(--color-tl-muted-text);

    --accent: var(--color-tl-surface-high);

    --destructive: var(--color-tl-destructive);
    --destructive-foreground: var(--color-tl-white);

    --success: var(--color-tl-success);
    --success-foreground: var(--color-tl-white);

    --warning: var(--color-tl-warning);
    --warning-foreground: var(--foreground);

    --info: var(--color-tl-info);
    --info-foreground: var(--color-tl-white);

    --border: var(--color-tl-border);
    --surface-low: var(--color-tl-surface-low);
    --surface-high: var(--color-tl-surface-high);

    --sidebar: var(--background);
    --sidebar-primary-foreground: var(--color-tl-white);

    --coral: var(--color-tl-coral);
    --coral-foreground: var(--color-tl-white);
    --purple: var(--color-tl-purple);
    --purple-foreground: var(--color-tl-white);

    --radius: 0.625rem;
  }

  .dark {
    /* TOKYO NIGHT (DARK) MAPPINGS */
    --background: var(--color-tn-canvas);
    --foreground: var(--color-tn-text);
    --card: var(--color-tn-surface);
    --popover: var(--color-tn-surface);

    --primary: var(--color-tn-primary);
    --primary-foreground: var(--background);

    --secondary: var(--color-tn-surface-muted);
    --muted: var(--color-tn-surface-muted);
    --muted-foreground: var(--color-tn-muted-text);

    --accent: var(--color-tn-border);

    --destructive: var(--color-tn-destructive);
    --destructive-foreground: var(--background);

    --success: var(--color-tn-success);
    --success-foreground: var(--background);

    --warning: var(--color-tn-warning);
    --warning-foreground: var(--background);

    --info: var(--color-tn-info);
    --info-foreground: var(--background);

    --border: var(--color-tn-border);
    --surface-low: var(--color-tn-surface-low);
    --surface-high: var(--color-tn-surface-high);

    --sidebar: var(--surface-low);
    --sidebar-primary-foreground: var(--background);

    --coral: var(--color-tn-coral);
    --coral-foreground: var(--background);
    --purple: var(--color-tn-purple);
    --purple-foreground: var(--background);
  }

  * {
    @apply border-border;
  }

  body {
    @apply bg-background text-foreground;
    font-feature-settings:
      'rlig' 1,
      'calt' 1;
  }
}
